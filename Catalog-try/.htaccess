# Habilitar el rewrite engine
RewriteEngine On

# Redirigir a HTTPS si el sitio lo soporta
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Establecer la página de inicio predeterminada
DirectoryIndex index.php index.html

# Reescribir URLs amigables
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php?$1 [L,QSA]

# Proteger archivos sensibles
<FilesMatch "(^.*\.ini|^.*\.log|^.*\.sql|^.*\.bak|^.*\.config)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Configurar cache estática para mejorar el rendimiento
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 6 months"
    ExpiresByType image/png "access plus 6 months"
    ExpiresByType image/gif "access plus 6 months"
    ExpiresByType application/pdf "access plus 1 month"
</IfModule>

# Habilitar la compresión para optimizar la velocidad
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript
</IfModule>
